# Supabase project used by apps/api/src/db/supabase.ts (see supabase/schema.sql for the tables
# these point at). Get these from your project's Settings > API page.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional. POST /api/explain phrases the engine's own facts via Claude when set; when unset (or
# the call fails/times out) apps/api/src/llm/fallback.ts renders instead — the app never blocks
# or goes blank on this (SPEC.md §9/§6).
ANTHROPIC_API_KEY=

# Optional, defaults to 4000.
PORT=4000
